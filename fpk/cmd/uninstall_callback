#!/bin/sh
set -eu
case "${wizard_uninstall_data:-keep}" in
  keep) exit 0 ;;
  clear)
    pkgvar="${TRIM_PKGVAR:?}"
    [ "$pkgvar" != "/" ] || { echo "refusing root package var" >&2; exit 1; }
    data_dir="$pkgvar/data"
    case "$data_dir" in
      */data) rm -rf -- "$data_dir" ;;
      *) echo "refusing unsafe data path" >&2; exit 1 ;;
    esac
    ;;
  *) echo "unknown uninstall data mode" >&2; exit 1 ;;
esac
