#!/bin/sh
set -eu
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
. "$SCRIPT_DIR/common"
resolve_paths
port=${wizard_siyuan_port:-6806}
if ! valid_port "$port"; then
  printf '%s\n' "思源端口必须是 1-65535。" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
  exit 1
fi
if [ "$port" = "36806" ]; then
  printf '%s\n' "端口 36806 由内置 Sisyphus MCP 使用，请选择其他思源端口。" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
  exit 1
fi
mkdir -p "$SIYUAN_WORKSPACE" "$SIYUAN_CONFIG/home"
printf '%s\n' "$port" > "$PORT_FILE"
chmod 600 "$PORT_FILE"
if [ -n "${wizard_access_auth_code:-}" ]; then
  printf '%s\n' "$wizard_access_auth_code" > "$AUTH_FILE"
  chmod 600 "$AUTH_FILE"
elif [ ! -s "$AUTH_FILE" ]; then
  printf '%s\n' "首次安装必须设置思源锁屏密码。" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
  exit 1
fi
